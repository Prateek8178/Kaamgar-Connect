PORT=5000
MONGO_URI=mongodb://localhost:27017/kaamgar_connect
JWT_SECRET=kaamgar-connect-jwt-secret-change-in-production-2025
JWT_EXPIRES_IN=7d

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=Kaamgar Connect <your-gmail@gmail.com>

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
